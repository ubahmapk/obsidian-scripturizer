{"data":{"id":"LUK.15.25-LUK.15.32","orgId":"LUK.15.25-LUK.15.32","bibleId":"a556c5305ee15c3f-01","bookId":"LUK","chapterIds":["LUK.15"],"reference":"Luke 15:25-32","content":[{"name":"para","type":"tag","attrs":{"style":"p"},"items":[{"name":"verse","type":"tag","attrs":{"number":"25","style":"v","sid":"LUK 15:25"},"items":[{"text":"25","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"“Now his older son was in the field; as he came near the house, he heard music and dancing.","type":"text","attrs":{"verseId":"LUK.15.25","verseOrgIds":["LUK.15.25"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.25","verseOrgIds":["LUK.15.25"]}},{"name":"verse","type":"tag","attrs":{"number":"26","style":"v","sid":"LUK 15:26"},"items":[{"text":"26","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"So he summoned one of the servants, questioning what these things meant.","type":"text","attrs":{"verseId":"LUK.15.26","verseOrgIds":["LUK.15.26"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.26","verseOrgIds":["LUK.15.26"]}},{"name":"verse","type":"tag","attrs":{"number":"27","style":"v","sid":"LUK 15:27"},"items":[{"text":"27","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"‘Your brother is here,’ he told him, ‘and your father has slaughtered the fattened calf because he has him back safe and sound.’","type":"text","attrs":{"verseId":"LUK.15.27","verseOrgIds":["LUK.15.27"]}}]}]},{"name":"para","type":"tag","attrs":{"style":"p"},"items":[{"name":"verse","type":"tag","attrs":{"number":"28","style":"v","sid":"LUK 15:28"},"items":[{"text":"28","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"“Then he became angry and didn’t want to go in. So his father came out and pleaded with him.","type":"text","attrs":{"verseId":"LUK.15.28","verseOrgIds":["LUK.15.28"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.28","verseOrgIds":["LUK.15.28"]}},{"name":"verse","type":"tag","attrs":{"number":"29","style":"v","sid":"LUK 15:29"},"items":[{"text":"29","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"But he replied to his father, ‘Look, I have been slaving many years for you, and I have never disobeyed your orders, yet you never gave me a goat so that I could celebrate with my friends.","type":"text","attrs":{"verseId":"LUK.15.29","verseOrgIds":["LUK.15.29"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.29","verseOrgIds":["LUK.15.29"]}},{"name":"verse","type":"tag","attrs":{"number":"30","style":"v","sid":"LUK 15:30"},"items":[{"text":"30","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"But when this son of yours came, who has devoured your assets","type":"text","attrs":{"verseId":"LUK.15.30","verseOrgIds":["LUK.15.30"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.30","verseOrgIds":["LUK.15.30"]}},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"with prostitutes,","type":"text","attrs":{"verseId":"LUK.15.30","verseOrgIds":["LUK.15.30"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.30","verseOrgIds":["LUK.15.30"]}},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"you slaughtered the fattened calf for him.’","type":"text","attrs":{"verseId":"LUK.15.30","verseOrgIds":["LUK.15.30"]}}]}]},{"name":"para","type":"tag","attrs":{"style":"p"},"items":[{"name":"verse","type":"tag","attrs":{"number":"31","style":"v","sid":"LUK 15:31"},"items":[{"text":"31","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"“ ‘Son,’","type":"text","attrs":{"verseId":"LUK.15.31","verseOrgIds":["LUK.15.31"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.31","verseOrgIds":["LUK.15.31"]}},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"he said to him, ‘you are always with me,","type":"text","attrs":{"verseId":"LUK.15.31","verseOrgIds":["LUK.15.31"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.31","verseOrgIds":["LUK.15.31"]}},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"and everything I have is yours.","type":"text","attrs":{"verseId":"LUK.15.31","verseOrgIds":["LUK.15.31"]}}]},{"text":" ","type":"text","attrs":{"verseId":"LUK.15.31","verseOrgIds":["LUK.15.31"]}},{"name":"verse","type":"tag","attrs":{"number":"32","style":"v","sid":"LUK 15:32"},"items":[{"text":"32","type":"text"}]},{"name":"char","type":"tag","attrs":{"style":"wj"},"items":[{"text":"But we had to celebrate and rejoice, because this brother of yours was dead and is alive again; he was lost and is found.’ ”","type":"text","attrs":{"verseId":"LUK.15.32","verseOrgIds":["LUK.15.32"]}}]}]}],"verseCount":8,"copyright":"© 2017 Holman Bible Publishers"},"meta":{"fumsToken":"G1sBABwHbqxlyoOgvZ5F-_vUJ68O-_BDU4QShGTp6guddacH1f944O9w_KllYVsSYYItsNqCuOUkYWCS5O-3fzxvB0BfQcl5vOvUvZh7Ml8ug8_Tii3onY537fTaElyis2eKgGk1ohkBAMcfQ1fNBWAKUO7qpg0kY9C3vmerOOauxUZOjZClSjYGbO_PFs_bEvQMW2A-EYgglSXcLSrC6nm8L_wZzD3NfMXZQ-C8yhXPVnHOVZ7mKtRiUZeOAQ"}}