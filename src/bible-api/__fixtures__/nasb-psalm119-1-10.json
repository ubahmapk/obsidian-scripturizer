        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q",
          "vid": "PSA 119:10"
        },
        "items": [
          {
            "text": "Do not let me wander from Your commandments.",
            "type": "text",
            "attrs": {
              "verseId": "PSA.119.10",
              "verseOrgIds": [
                "PSA.119.10"
              ]
            }
          }
        ]
