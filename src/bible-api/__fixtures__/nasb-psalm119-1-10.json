        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q",
          "vid": "PSA 119:9"
        },
        "items": [
          {
            "text": "By keeping ",
            "type": "text",
            "attrs": {
              "verseId": "PSA.119.9",
              "verseOrgIds": [
                "PSA.119.9"
              ]
