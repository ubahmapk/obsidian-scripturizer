        "name": "para",
        "type": "tag",
        "attrs": {
          "style": "q",
          "vid": "PSA 119:7"
        },
        "items": [
          {
            "text": "When I learn Your righteous judgments.",
            "type": "text",
            "attrs": {
              "verseId": "PSA.119.7",
              "verseOrgIds": [
                "PSA.119.7"
              ]
            }
          }
        ]
      },
